# ==========================================
# LeSeft Nigeria Limited - Environment Configuration
# ==========================================

# 1. Shared Sanity CMS Configuration (web + Studio)
# Project ID: Sanity Manage > project settings. Dataset: Sanity Manage > API > Datasets.
NEXT_PUBLIC_SANITY_PROJECT_ID="5c2yalf2"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-03-01"
# For the Vercel multi-service deployment, use /studio.
NEXT_PUBLIC_SANITY_STUDIO_URL="/studio"

# 2. Sanity API Tokens (Server-side only - Do NOT prefix with NEXT_PUBLIC)
# Generate in Sanity Manage > API > Tokens (Viewer/Editor role)
SANITY_API_READ_TOKEN=""
SANITY_API_WRITE_TOKEN=""

# 3. Cloudinary CDN Configuration (For Email & Corporate Assets)
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="leseft-nigeria"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 4. Email Provider Adapter
# Options: 'simulator' (default for sandbox testing), 'resend', 'sendgrid', 'postmark', 'webhook'
EMAIL_PROVIDER="simulator"
EMAIL_FROM_ADDRESS="corporate@leseft.com"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_WEBHOOK_URL=""
